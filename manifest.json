{
  "manifest_version": 3,
  "name": "Clockify Salary Calculator",
  "version": "1.3.0",
  "description": "Display your salary earnings next to total time on the Clockify dashboard.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://app.clockify.me/*",
    "https://open.er-api.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.clockify.me/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
